# ─────────────────────────────────────────────────────────────
# Copie ce fichier en ".env" puis remplis les valeurs.
# Le fichier .env ne doit JAMAIS être envoyé sur GitHub.
# ─────────────────────────────────────────────────────────────

# Clé secrète de Payload (signe les sessions). Longue chaîne aléatoire.
# Génère-la avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=remplace-moi-par-une-longue-chaine-aleatoire

# Adresse publique du CMS (laisser vide en dev pour l'ouvrir depuis tous tes appareils)
# En production : https://cms.ton-agence.fr
PUBLIC_SERVER_URL=

# ── Base de données PostgreSQL ──
# Dev (Docker local) :
DATABASE_URI=postgres://cms:cms@localhost:5432/cms
# Plus tard, Supabase : postgres://postgres.xxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
# Base utilisée par les tests automatiques (elle est vidée à chaque test) :
DATABASE_URI_TEST=postgres://cms:cms@localhost:5432/cms_test

# ── Stockage des fichiers (S3 : MinIO en dev, Cloudflare R2 en prod) ──
# Laisser S3_BUCKET vide pour stocker les fichiers sur le disque (dossier media/)
S3_BUCKET=media
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio-secret
S3_FORCE_PATH_STYLE=true

# ── E-mails ──
# Dev : Mailpit (voir les e-mails sur http://localhost:8025)
# Prod : Brevo -> SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=noreply@ton-agence.fr
EMAIL_FROM_NAME=Ton Agence

# Adresse qui reçoit les demandes de support des clients
AGENCY_EMAIL=toi@ton-agence.fr

# ── Premier compte super administrateur (utilisé par "pnpm seed") ──
SEED_ADMIN_EMAIL=toi@ton-agence.fr
SEED_ADMIN_PASSWORD=change-moi-tout-de-suite

# ── Production uniquement : jeton du tunnel Cloudflare (docker-compose.prod.yml) ──
CLOUDFLARE_TUNNEL_TOKEN=
